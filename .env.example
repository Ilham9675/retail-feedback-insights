# Copy to .env (never commit .env) or set these as environment variables.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: reviews per Gemini request
FEEDBACK_AI_BATCH_SIZE=25
# Optional: path to the sentiment analysis output (relative to the repository root)
FEEDBACK_INPUT_FILE=data/sentiment_feedback_output.txt
